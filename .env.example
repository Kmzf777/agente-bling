# Provider do agente (default anthropic)
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-4-6
# Modelo barato para consultas simples (roteamento automático) — Haiku ~3x mais barato
AGENT_MODEL_SIMPLES=claude-haiku-4-5
ANTHROPIC_API_KEY=
AGENT_MAX_STEPS=20
# Taxa fixa USD→BRL para exibir o custo estimado de cada resposta em reais
USD_BRL=5.60

# OpenAI (legado — não é mais obrigatório)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bling OAuth (API v3)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback
# IDs (separados por vírgula) das situações consideradas "faturado" na sua conta Bling
BLING_SITUACAO_FATURADO_IDS=
# ID do contato "Fabrica" — o Canastra registra produção como pedido de compra desse contato
PRODUCAO_CONTATO_ID=11424392310

# App
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-segredo-aleatorio-longo
PORT=3000

# CORS: origem permitida do frontend. "*" é seguro pois a auth é por token Bearer.
# Em produção dá para restringir, ex.: CORS_ORIGIN=https://agente-bling.vercel.app
CORS_ORIGIN=*

# --- Canal WhatsApp (Evolution API) — opcional. Deixe vazio para desligar o canal. ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=            # mesma chave usada no docker-compose (AUTHENTICATION_API_KEY)
EVOLUTION_INSTANCE=canastra
WHATSAPP_ACCESS_PASSWORD=     # senha exigida na 1ª mensagem de cada número
WHATSAPP_SESSION_TIMEOUT_MIN=30

# --- Frontend (NÃO é lido pelo backend) ---
# O frontend usa VITE_API_BASE (URL pública do backend via ngrok). Configure em
# `web/.env.production` (já versionado) ou no painel da Vercel. Exemplo atual:
VITE_API_BASE=https://basis-sleeve-baked.ngrok-free.dev
